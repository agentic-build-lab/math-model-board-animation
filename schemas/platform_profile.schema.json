{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.agentic_build_lab/schemas/platform_profile.schema.json",
  "title": "platform_profile",
  "type": "object",
  "required": [
    "key",
    "platform",
    "content_format",
    "readiness",
    "dimensions",
    "metric_aliases",
    "unavailable_metrics",
    "compliance_notes",
    "product_notes"
  ],
  "additionalProperties": true,
  "properties": {
    "key": { "type": "string" },
    "platform": { "type": "string" },
    "content_format": { "type": "string" },
    "readiness": {
      "type": "string",
      "enum": [
        "official_api_ready",
        "authorized_only",
        "best_effort_public_observation",
        "research_or_experimental"
      ]
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "name", "weight", "description"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string" },
          "name": { "type": "string" },
          "weight": { "type": "number", "exclusiveMinimum": 0 },
          "description": { "type": "string" }
        }
      }
    },
    "metric_aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "unavailable_metrics": { "type": "array", "items": { "type": "string" } },
    "compliance_notes": { "type": "array", "items": { "type": "string" } },
    "product_notes": { "type": "array", "items": { "type": "string" } }
  }
}
